APP_CSS    RCDATA "app.css"
APP_JS     RCDATA "app.js"
APPEARANCE_JS RCDATA "appearance.js"
ELEMENTS_JS   RCDATA "elements.js"
SETTINGS_JS   RCDATA "settings.js"
DECK_JS       RCDATA "deck.js"
